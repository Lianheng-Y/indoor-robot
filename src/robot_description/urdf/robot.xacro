<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="indoor_robot">
  <xacro:arg name="body_length" default="0.60"/>
  <xacro:arg name="body_width" default="0.40"/>
  <xacro:arg name="body_height" default="0.20"/>
  <xacro:arg name="wheel_radius" default="0.10"/>
  <xacro:arg name="wheel_width" default="0.05"/>
  <xacro:arg name="wheel_separation" default="0.45"/>
  <xacro:arg name="body_mass" default="20.0"/>
  <xacro:arg name="hardware_plugin" default="mock_components/GenericSystem"/>
  <xacro:arg name="transport" default="serial"/>
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>
  <xacro:arg name="baud_rate" default="115200"/>
  <xacro:arg name="can_interface" default="can0"/>
  <xacro:arg name="encoder_cpr" default="4096"/>
  <xacro:arg name="gear_ratio" default="1.0"/>

  <xacro:property name="body_length" value="$(arg body_length)"/>
  <xacro:property name="body_width" value="$(arg body_width)"/>
  <xacro:property name="body_height" value="$(arg body_height)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="$(arg wheel_width)"/>
  <xacro:property name="wheel_separation" value="$(arg wheel_separation)"/>
  <xacro:property name="body_mass" value="$(arg body_mass)"/>

  <ros2_control name="IndoorRobotSystem" type="system">
    <hardware>
      <!-- Replace with the serial/CAN hardware plugin on the real robot. -->
      <plugin>$(arg hardware_plugin)</plugin>
      <param name="transport">$(arg transport)</param>
      <param name="serial_port">$(arg serial_port)</param>
      <param name="baud_rate">$(arg baud_rate)</param>
      <param name="can_interface">$(arg can_interface)</param>
      <param name="encoder_cpr">$(arg encoder_cpr)</param>
      <param name="gear_ratio">$(arg gear_ratio)</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <xacro:include filename="$(find robot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find robot_description)/urdf/gazebo.xacro"/>

  <link name="base_footprint"/>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 ${body_height / 2}"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.34" ixy="0" ixz="0" iyy="0.64" iyz="0" izz="0.87"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${body_height / 2}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height / 2}"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="left_wheel">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 ${wheel_separation / 2} ${wheel_radius}"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -${wheel_separation / 2} ${wheel_radius}"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:lidar_sensor parent="base_link" xyz="0.16 0 ${body_height + 0.02}"/>
  <xacro:imu_sensor parent="base_link" xyz="0 0 ${body_height}"/>
  <xacro:gazebo_drive left_joint="left_wheel_joint" right_joint="right_wheel_joint"
                       wheel_separation="${wheel_separation}" wheel_radius="${wheel_radius}"/>
</robot>
