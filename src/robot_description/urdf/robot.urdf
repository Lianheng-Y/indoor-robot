<?xml version="1.0"?>
<robot name="indoor_robot">
  <material name="body_blue">
    <color rgba="0.10 0.35 0.70 1.0"/>
  </material>
  <material name="wheel_dark">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>
  <material name="sensor_gray">
    <color rgba="0.55 0.60 0.65 1.0"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.12"/>
      <mass value="20.0"/>
      <inertia ixx="0.34" ixy="0" ixz="0" iyy="0.64" iyz="0" izz="0.87"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="0.60 0.40 0.20"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.12"/>
      <geometry><box size="0.60 0.40 0.20"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <joint name="left_wheel_joint" type="fixed">
    <origin xyz="0 0.225 0.10"/>
    <parent link="base_link"/>
    <child link="left_wheel"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.10" length="0.05"/></geometry>
      <material name="wheel_dark"/>
    </visual>
  </link>
  <joint name="right_wheel_joint" type="fixed">
    <origin xyz="0 -0.225 0.10"/>
    <parent link="base_link"/>
    <child link="right_wheel"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.035"/>
      <geometry><cylinder radius="0.06" length="0.07"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.16 0 0.22"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>
</robot>
